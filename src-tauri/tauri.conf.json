{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "里程票价查询",
  "version": "../package.json",
  "identifier": "com.metrofare.app",
  "build": {
    "beforeBuildCommand": "node scripts/web.mjs",
    "frontendDist": "../release/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "城市轨道交通票价查询软件",
        "width": 1360,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "里程查询与多城市轨道票价对比",
    "longDescription": "输入里程查询普通轨道交通票价，支持单城查询、多城对比与来源核查",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "useLocalToolsDir": true
  }
}
