{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "地铁票价对比",
  "version": "../package.json",
  "identifier": "com.metrofare.app",
  "build": {
    "beforeBuildCommand": "node scripts/web.mjs",
    "frontendDist": "../release/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "全国城市轨道交通票价对比",
        "width": 1360,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f7f3ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "城市轨道交通票价对比",
    "longDescription": "离线查看中国内地 45 座城市轨道交通的票价-里程换算关系，支持自定义基准票价、点表头排序与同规则城市合并。",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "useLocalToolsDir": true
  }
}
