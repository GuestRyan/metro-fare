# Tauri / 前端
node_modules/
/src-tauri/target/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/.kotlin/
/src-tauri/gen/android/.tauri/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/app/tauri.build.gradle.kts
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/

# 构建临时目录（放工具链缓存，不能删）
build/

# 发布产物：只锚定仓库根的 release/，不要写成裸 `release/`
# ——那会连 src-tauri/target/release、gen/android/**/release 一起忽略。
# 用 `/release/*` 忽略内容而保留父目录，才能用 `!` 把 release/README.md 纳回版本管理。
/release/*
!/release/README.md
!/release/web/.gitkeep

# 苹果端产物（本机不构建，保留生成物无意义）
/src-tauri/icons/ios/
/src-tauri/gen/apple/

# 图标源图（中间产物）
/icon-src.png
/_mkicon.py
/.tmp-icon/

# 本地 Android 签名（绝不入库）
*.jks
*.keystore
keystore.properties
key.properties
.env.local
.env.*.local

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/

# 草稿、截图、验收日志和交付归档
/workfiles/

# 本地登记提交包，含个人身份填写信息
/提交/

# 本地协作工具的工程数据（不随源码仓分发）
/.workbuddy/
